# Copie este arquivo para .env.dev dentro de web-data-viz/.
# O app.js da turma carrega .env.dev no modo desenvolvimento.
AMBIENTE_PROCESSO=desenvolvimento
APP_HOST=localhost
APP_PORT=3333

# Reservado para a etapa de integração com MySQL.
# Não é necessário configurar o banco para abrir as três páginas.
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=aquatech
DB_USER=
DB_PASSWORD=
