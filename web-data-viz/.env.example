# Copie este arquivo para .env.dev dentro de web-data-viz/.
# O app.js da turma carrega .env.dev no modo desenvolvimento.
AMBIENTE_PROCESSO=desenvolvimento
APP_HOST=localhost
APP_PORT=3333

# Banco MySQL da VM Linux (passo a passo em docs/vm-ubuntu.md).
# Preencha usuário e senha no seu .env.dev, nunca neste arquivo.
DB_HOST=127.0.0.1
DB_PORT=3307
DB_DATABASE=memorias_aventura
DB_USER=
DB_PASSWORD=
